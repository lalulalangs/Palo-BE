# =============================================================================
# PALORINJANI — Contoh konfigurasi
# =============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan:
#     cp .env.example .env
#     php artisan key:generate
#
# JANGAN PERNAH commit file `.env` yang sudah terisi. `.env` berisi kredensial
# database, payment gateway, dan kredensial admin.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplikasi
# -----------------------------------------------------------------------------
APP_NAME="Palo Mountain Goods"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000

# BAHASA: id, bukan en.
# PRD §7 menaruh "multi-bahasa (i18n) selain Bahasa Indonesia" di luar scope.
# Seluruh halaman, pesan error, dan tanggal menggunakan Bahasa Indonesia.
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# 12 adalah nilai bcrypt yang direkomendasikan Laravel saat ini (bukan 10
# yang sering muncul di tutorial lama).
# PRD §3.12: "Password disimpan dengan hashing standar industri (bcrypt/argon2)"
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Database — PostgreSQL adalah SATU-SATUNYA sumber kebenaran
# -----------------------------------------------------------------------------
# system_map §2: "PostgreSQL: sumber kebenaran SKU, stok, reservasi, order,
# pembayaran, voucher, dan audit."
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=palorinjani
DB_USERNAME=palorinjani
DB_PASSWORD=
#Jangan unset yang di produksi — wajib HTTPS (PRD §4.2)
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Session, Cache, Queue — WAJIB Redis
# -----------------------------------------------------------------------------
# system_map §2: "Redis: cache, cart/session guest, rate limit dan queue."
# PRD §4.3: "Redis menangani queue job (kirim notifikasi, generate invoice)
# secara asinkron agar tidak memblokir request utama."
#
# PENTING: jangan ganti ke `database` di produksi. Kalau Redis mati, seluruh
# session & antrean ikut mati — dan sistem akan gagal mengirim notifikasi
# tanpa ada yang memberikan tahu.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Wajib true di produksi: cookie session berisi token auth.
# PRD §4.2 mensyaratkan seluruh trafik terenkripsi.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=palorinjani

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=s3

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache state katalog. PRD §4.1: "Halaman katalog & homepage menerapkan caching
# dengan invalidasi otomatis saat data produk/stok berubah."
# Di produksi, invalidasi cache dilakukan otomatis oleh listener Filament.
CATALOG_CACHE_TTL=300

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# PRD §5: SMTP Email untuk notifikasi order & reset password.
# MAIL_MAILER=log berarti email ditulis ke file log, bukan benar-benar dikirim.
# Jangan biarkan `log` di produksi — pembeli tidak akan menerima konfirmasi.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@palorinjani.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Object Storage (S3 / MinIO)
# -----------------------------------------------------------------------------
# PRD §3.2: "Galeri media (multi-gambar) di-serve dari Object Storage, bukan
# disk lokal server."
# Kalau MinIO lokal (docker-compose), set AWS_ENDPOINT=http://minio:9000
# dan AWS_USE_PATH_STYLE_ENDPOINT=true.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=palorinjani-media
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Payment Gateway
# -----------------------------------------------------------------------------
# Lihat docs/KEPUTUSAN-TERBUKA.md OD-01 — vendor BELUM diputuskan antara
# Midtrans dan Xendit. Default `dummy` membuat checkout mengembalikan 502
# dengan pesan jelas, BUKAN<Order bogus.
#
# Jangan pernah mengisi nilai contoh di sini dan berharap itu bekerja.
GATEWAY_NAME=dummy
GATEWAY_SANDBOX=true
GATEWAY_MAX_ATTEMPTS=3

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

XENDIT_SECRET_KEY=

# Kunci untuk memverifikasi signature webhook (PRD §3.7). WAJIB diisi sebelum
# endpoint webhook boleh dipakai. Kosong = semua webhook ditolak.
GATEWAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Kurir Logistik
# -----------------------------------------------------------------------------
# Lihat docs/KEPUTUSAN-TERBUKA.md OD-02.
COURIER_NAME=dummy
COURIER_TIMEOUT_SECONDS=8

RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
RAJAONGKIR_TIER=starter

# -----------------------------------------------------------------------------
# Asal Pengiriman
# -----------------------------------------------------------------------------
# PRD §6A: alamat asal perlu dikonfirmasi pemilik. Nilai di sini default
# development saja; yang dipakai sistem adalah app_settings.
SHIPPING_ORIGIN_NAME="Toko Senaru"
SHIPPING_ORIGIN_CITY="Senaru"
SHIPPING_ORIGIN_CITY_CODE=5204
SHIPPING_ORIGIN_POSTAL_CODE=83273

# -----------------------------------------------------------------------------
# Reservasi Stok
# -----------------------------------------------------------------------------
# PENTING: nilai ini HANYA berlaku SEBELUM payment gateway merespons.
# Setelahnya, masa reservasi mengikuti batas bayar EFEKTIF dari gateway
# (PRD §3.6). Jangan menaikkan angka ini thinking "biar aman" — itu membuat
# stok terkunci lebih lama dari yang dijamin gateway.
RESERVATION_PROVISIONAL_MINUTES=30

# -----------------------------------------------------------------------------
# Brand & WhatsApp
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BRAND_PUBLIC_NAME="Palo Mountain Goods"
BRAND_INTERNAL_NAME=PALORINJANI

# Hanya FALLBACK untuk development. Di produksi, nomor CS diambil dari
# app_settings (key: whatsapp.cs_number) supaya bisa diganti tanpa deploy
# (PRD §3.11).
WHATSAPP_CS_NUMBER_FALLBACK=6280000000000
WHATSAPP_SHOP_NAME="Palo Mountain Goods"

# -----------------------------------------------------------------------------
# Akun Admin Pertama (dipakai oleh seeder)
# -----------------------------------------------------------------------------
# Kalau kosong, seeder TIDAK membuat akun admin sama sekali — lebih baik
# tidak ada admin daripada ada admin dengan password di repository.
# Buat manual kalau perlu: php artisan make:filament-user
ADMIN_NAME="Admin Palo Senaru"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Guard Seeder
# -----------------------------------------------------------------------------
# JANGAN set true di produksi.
# PRD §6A melarang mempublikasikan produk contoh sebelum admin mengisi data
# asli. Sebaliknya, kalau true, seeder boleh membuat katalog contoh.
ALLOW_SEED_PRODUCTS=false

# -----------------------------------------------------------------------------
# Vite
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
