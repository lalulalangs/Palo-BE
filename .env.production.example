# Contoh konfigurasi PRODUKSI — salin ke `.env` di server produksi.
# Jangan pernah memakai berkas ini apa adanya: isi APP_KEY, DB_PASSWORD,
# dan kredensial lain lewat secret manager / environment server.

APP_NAME="Palo Mountain Goods"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.palorinjani.com

# Origin storefront yang diizinkan mengakses API (dipisah koma).
FRONTEND_URL=https://palorinjani.com
CORS_ALLOWED_ORIGINS=https://palorinjani.com,https://www.palorinjani.com

APP_TIMEZONE=Asia/Makassar

# Wajib diisi di produksi; seeder menolak membuat superadmin tanpa nilai ini.
ADMIN_NAME="Admin PaloRinjani"
ADMIN_EMAIL=admin@palorinjani.com
ADMIN_PASSWORD=

# Token API kedaluwarsa otomatis setelah 7 hari (10.080 menit).
SANCTUM_EXPIRATION=10080

# Batas upload gambar (KB) dan resolusi maksimum yang divalidasi di form.
IMAGE_MAX_UPLOAD_KB=2048
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_PIXELS=50000000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=palorinjani_db
DB_USERNAME=palorinjani
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@palorinjani.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
